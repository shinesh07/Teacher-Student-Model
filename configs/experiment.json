    "confidence_thresholds": [0.5, 0.6, 0.7, 0.8, 0.9, 0.95]
  },
  "unsupervised": {
    "teacher_clusters": [6, 8, 10],
    "student_clusters": 2,
    "teacher_n_init": 10,
    "student_n_init": 10,
    "batch_size": 4096
  },
  "execution": {
    "prediction_chunk_pixels": 8192,
    "timing_test_images": 58
  },
  "postprocessing": {
    "mode": "none",
    "median_size": 3,
    "min_component_area": 0
