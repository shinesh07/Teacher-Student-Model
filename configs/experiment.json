    "kmeans_student_fit_pixels": 20000,
    "validation_pixels_per_image": 512
  },
  "features": {
    "student": ["red", "green", "blue", "hue", "saturation", "value"],
    "teacher": [
      "red", "green", "blue", "hue", "saturation", "value",
      "blurred_red_sigma1", "blurred_green_sigma1", "blurred_blue_sigma1",
      "blurred_red_sigma3", "blurred_green_sigma3", "blurred_blue_sigma3",
