{
  "seed": 42,
  "dataset": {
    "slug": "faizalkarim/flood-area-segmentation",
    "root": "data/raw",
    "image_dir": "Image",
    "mask_dir": "Mask",
    "expected_image_count": 290,
    "image_size": [256, 256],
    "mask_positive_threshold": 128
  },
  "sampling": {
    "labelled_pixels_per_image": 1250,
    "teacher_knn_reference_pixels": 30000,
    "student_knn_reference_pixels": 5000,
